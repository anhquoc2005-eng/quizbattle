# Sao chép file này thành .env ở gốc repo và điền giá trị thật. KHÔNG commit file .env.
# Biến của frontend nằm riêng ở frontend/.env.example.

# --- PostgreSQL dev (docker-compose.yml đọc các biến này) ---
POSTGRES_DB=quizbattle
POSTGRES_USER=quizbattle
POSTGRES_PASSWORD=

# --- Backend ---
# Khi dev: lưu bằng dotnet user-secrets (xem README), không cần đặt ở đây.
# Khi deploy: đặt các biến dưới đây trong phần cấu hình môi trường của nơi host backend.
# Production dùng chuỗi Session pooler (cổng 5432) của Supabase, ví dụ:
#   Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<mật khẩu>;SSL Mode=Require;Maximum Pool Size=10
ConnectionStrings__Default=Host=localhost;Port=5433;Database=quizbattle;Username=quizbattle;Password=

Jwt__Key=
Jwt__Issuer=quizbattle
Jwt__Audience=quizbattle

# Production: Ai__ApiKey, Ai__Model, Cors__AllowedOrigins là BẮT BUỘC (thiếu thì backend không khởi động).
# AI sinh câu hỏi (chỉ dùng ở backend, gọi Gemini - xem README để lấy key và chọn model Flash
# còn hạn mức miễn phí). Thiếu thì backend vẫn chạy, chỉ endpoint generate trả 503.
# Gói miễn phí của Gemini có thể dùng dữ liệu gửi lên để cải thiện model - không gửi dữ liệu cá nhân.
Ai__ApiKey=
Ai__Model=

# Domain frontend được gọi API, nhiều domain cách nhau bằng dấu phẩy
Cors__AllowedOrigins=http://localhost:5173

# --- Chỉ khi deploy sau proxy (Production) ---
# Render cấp PORT tự động, không cần đặt. Sau Cloudflare, IP khách nằm ở CF-Connecting-IP (mặc định: X-Forwarded-For).
ForwardedHeaders__ClientIpHeader=CF-Connecting-IP
