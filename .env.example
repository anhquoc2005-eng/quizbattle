# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# Database (PostgreSQL chạy bằng Docker)
POSTGRES_DB=quizbattle
POSTGRES_USER=quizbattle
POSTGRES_PASSWORD=
ConnectionStrings__Default=Host=localhost;Port=5432;Database=quizbattle;Username=quizbattle;Password=

# Xác thực
Jwt__Key=
Jwt__Issuer=quizbattle
Jwt__Audience=quizbattle

# AI sinh câu hỏi (chỉ dùng ở backend)
Ai__ApiKey=
Ai__Model=

# CORS: domain frontend được phép gọi API
Cors__AllowedOrigins=http://localhost:5173

# Frontend (Vite) — chỉ chứa URL, không chứa secret
VITE_API_URL=http://localhost:5000
