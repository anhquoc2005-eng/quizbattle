# Sao chép file này thành .env ở gốc repo và điền giá trị thật. KHÔNG commit file .env.
# Biến của frontend nằm riêng ở frontend/.env.example.

# --- PostgreSQL dev (docker-compose.yml đọc các biến này) ---
POSTGRES_DB=quizbattle
POSTGRES_USER=quizbattle
POSTGRES_PASSWORD=

# --- Backend ---
# Khi dev: lưu bằng dotnet user-secrets (xem README), không cần đặt ở đây.
# Khi deploy: đặt các biến dưới đây trong phần cấu hình môi trường của nơi host backend.
# Production dùng chuỗi Session pooler (cổng 5432) của Supabase.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=quizbattle;Username=quizbattle;Password=

Jwt__Key=
Jwt__Issuer=quizbattle
Jwt__Audience=quizbattle

# AI sinh câu hỏi (chỉ dùng ở backend)
Ai__ApiKey=
Ai__Model=

# Domain frontend được gọi API, nhiều domain cách nhau bằng dấu phẩy
Cors__AllowedOrigins=http://localhost:5173
